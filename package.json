{
  "name": "mosaico-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Painéis web interativos em tela cheia para Windows, com Chromium.",
  "author": "Mosaico",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 && node scripts/checksums.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "br.com.mosaico.desktop",
    "productName": "Mosaico",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "dist-electron/**/*", "build/icon.png", "package.json"],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "artifactName": "Mosaico-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Mosaico-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mosaico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "Mosaico-Portable-${version}.exe" }
  }
}
